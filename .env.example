# GreenPath environment configuration.
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is gitignored and must NEVER be committed. The server reads these via
# os.environ (see server.py) - no key is ever hardcoded in source or shipped to
# the browser.

# Required: OpenAI API key used by the server-side LLM proxy.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Optional.
# PORT=5000
# FLASK_DEBUG=false
